<Window x:Class="Strofas.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strofas — редактор меню"
        Width="1100"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E26">
    <Window.Resources>
        <!-- ===== v3: тёмные стили редактора в стиле меню ===== -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF26262F" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FF191920" />
        <SolidColorBrush x:Key="BorderBrush2" Color="#FF3A3A48" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7C9BFF" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#FF9A9AB0" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2E2E39" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3A3A48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3A3A49" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4C4C5E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF26262F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- акцентная кнопка «Сохранить» -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF7C9BFF" />
            <Setter Property="Foreground" Value="#FF12121A" />
            <Setter Property="BorderBrush" Value="#FF7C9BFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF93AEFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF6B8CFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF191920" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="CaretBrush" Value="#FF7C9BFF" />
            <Setter Property="BorderBrush" Value="#FF3A3A48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4C4C5E" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF7C9BFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF191920" />
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="BorderBrush" Value="#FF3A3A48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Width="8" Height="5"
                                                  Fill="#FF9A9AB0"
                                                  Data="M0,0 L4,4 L8,0 Z" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="content" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide" Focusable="False">
                                <Border Background="#FF26262F" BorderBrush="#FF3A3A48" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggle" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF33333F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF7C9BFF" />
                                <Setter Property="Foreground" Value="#FF12121A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFB8B8C8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                                    Background="#FF191920" BorderBrush="#FF3A3A48" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Visibility="Collapsed" Width="9" Height="8"
                                      Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Fill="#FF12121A"
                                      Data="M0,4 L3,7 L9,0" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF7C9BFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF7C9BFF" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF7C9BFF" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#FFE8E8F0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="exp" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Visibility="Collapsed">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2">
                                            <Path Width="6" Height="9" Fill="#FF9A9AB0"
                                                  Data="M0,0 L6,4.5 L0,9 Z" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="item" Background="Transparent" CornerRadius="5"
                                    Grid.Row="0" Padding="16,4,6,4" Margin="1">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ItemsPresenter x:Name="items" Grid.Row="1" Margin="14,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="exp" Property="Visibility" Value="Visible" />
                                <Setter TargetName="items" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="exp" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="items" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="item" Property="Background" Value="#FF2E2E39" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="item" Property="Background" Value="#337C9BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <DockPanel Grid.Row="0" Margin="10,10,10,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="AddLeafButton" Content="+ Пункт" Padding="10,4" Margin="0,0,6,0" Click="OnAddLeaf" />
                <Button x:Name="AddCategoryButton" Content="+ Категория" Padding="10,4" Margin="0,0,12,0" Click="OnAddCategory" />
                <Button Content="↑" Width="30" Padding="0,4" Margin="0,0,4,0" Click="OnMoveUp" />
                <Button Content="↓" Width="30" Padding="0,4" Margin="0,0,12,0" Click="OnMoveDown" />
                <Button Content="Удалить" Padding="10,4" Margin="0,0,16,0" Click="OnDelete" />
                <TextBlock Text="Горячка:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFB8B8C8" />
                <TextBox x:Name="HotkeyBox" Width="110" Padding="4,3" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock Text="Размер:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFB8B8C8" />
                <TextBox x:Name="SizeBox" Width="54" Padding="4,3" VerticalAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="CloseAfterBox" Content="Закрывать после действия"
                          VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FFB8B8C8" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Padding="14,4" Margin="0,0,8,0" Click="OnSave"
                        Style="{StaticResource AccentButton}" />
                <Button Content="Закрыть" Padding="14,4" Click="OnClose" />
            </StackPanel>
        </DockPanel>

        <!-- Тело: дерево | предпросмотр | свойства -->
        <Grid Grid.Row="1" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Дерево меню -->
            <Border Grid.Column="0" Background="#FF26262F" BorderBrush="#FF3A3A48" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Структура меню" FontWeight="SemiBold"
                               Foreground="#FFB8B8C8" Margin="4,2,4,6" />
                    <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                              Foreground="#FFE8E8F0" SelectedItemChanged="OnTreeSelected">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#FFE8E8F0" />
                                <Setter Property="FontSize" Value="13" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Предпросмотр -->
            <Border Grid.Column="1" Background="#FF26262F" BorderBrush="#FF3A3A48" BorderThickness="1" CornerRadius="8" Margin="0,0,8,0">
                <Grid>
                    <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Foreground="#FFB8B8C8"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8" />
                    <Canvas x:Name="PreviewCanvas" Width="480" Height="480"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent"
                            MouseMove="OnPreviewMouseMove" MouseLeave="OnPreviewMouseLeave" />
                </Grid>
            </Border>

            <!-- Свойства -->
            <Border Grid.Column="2" Background="#FF26262F" BorderBrush="#FF3A3A48" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Свойства пункта" FontWeight="SemiBold"
                               Foreground="#FFB8B8C8" Margin="2,0,2,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Название" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <TextBox x:Name="LabelBox" Padding="5,4" Margin="0,0,0,10" TextChanged="OnFieldChanged" />

                            <TextBlock Text="Иконка (ico / png / exe)" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="…" Width="30" Padding="0,4" Margin="6,0,0,0"
                                        Click="OnBrowseIcon" />
                                <TextBox x:Name="IconBox" Padding="5,4" TextChanged="OnFieldChanged" />
                            </DockPanel>

                            <TextBlock Text="Тип действия" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <ComboBox x:Name="ActionTypeBox" Padding="5,4" Margin="0,0,0,10"
                                      SelectionChanged="OnFieldChanged">
                                <ComboBoxItem Content="launch — запуск" Tag="launch" />
                                <ComboBoxItem Content="stop — остановить" Tag="stop" />
                                <ComboBoxItem Content="toggle — запуск/остановка" Tag="toggle" />
                                <ComboBoxItem Content="github — обновление из релизов" Tag="github" />
                                <ComboBoxItem Content="(нет действия)" Tag="" />
                            </ComboBox>

                            <TextBlock x:Name="PathRow" Text="Путь (exe / файл / папка / URL)" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <DockPanel x:Name="PathBoxRow" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="…" Width="30" Padding="0,4" Margin="6,0,0,0"
                                        Click="OnBrowsePath" />
                                <TextBox x:Name="PathBox" Padding="5,4" TextChanged="OnFieldChanged" />
                            </DockPanel>

                            <TextBlock Text="Аргументы" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <TextBox x:Name="ArgsBox" Padding="5,4" Margin="0,0,0,10" TextChanged="OnFieldChanged" />

                            <TextBlock x:Name="WorkDirRow" Text="Рабочая папка" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <DockPanel x:Name="WorkDirBoxRow" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="…" Width="30" Padding="0,4" Margin="6,0,0,0"
                                        Click="OnBrowseWorkDir" />
                                <TextBox x:Name="WorkDirBox" Padding="5,4" TextChanged="OnFieldChanged" />
                            </DockPanel>

                            <TextBlock Text="Имя процесса (для stop / toggle)" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                            <TextBox x:Name="ProcessBox" Padding="5,4" Margin="0,0,0,10" TextChanged="OnFieldChanged" />

                            <CheckBox x:Name="HiddenBox" Content="Запускать скрытым окном"
                                      Foreground="#FFB8B8C8" Margin="0,0,0,4"
                                      Checked="OnFieldChanged" Unchecked="OnFieldChanged" />

                            <!-- github-приложения -->
                            <StackPanel x:Name="GithubPanel" Visibility="Collapsed">
                                <TextBlock Text="Репозиторий (owner/repo или ссылка на releases)"
                                           Foreground="#FF9A9AB0" Margin="0,8,0,3" />
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" x:Name="CheckButton" Content="Проверить"
                                            Padding="8,4" Margin="6,0,0,0" Click="OnCheckRepo" />
                                    <TextBox x:Name="RepoBox" Padding="5,4" TextChanged="OnFieldChanged" />
                                </DockPanel>

                                <TextBlock Text="Тег (latest или v1.2.3)" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                                <TextBox x:Name="TagBox" Padding="5,4" Margin="0,0,0,10" TextChanged="OnFieldChanged" />

                                <TextBlock Text="Ассет — exe в релизе" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                                <ComboBox x:Name="AssetBox" IsEditable="True" Padding="5,4" Margin="0,0,0,10"
                                          SelectionChanged="OnFieldChanged" LostFocus="OnFieldChanged" />

                                <CheckBox x:Name="AutoUpdateBox" Content="Авто-обновление при открытии меню"
                                          Foreground="#FFB8B8C8" Margin="0,0,0,6"
                                          Checked="OnFieldChanged" Unchecked="OnFieldChanged" />

                                <TextBlock Text="sha256 ассета (опционально)" Foreground="#FF9A9AB0" Margin="0,0,0,3" />
                                <TextBox x:Name="ShaBox" Padding="5,4" Margin="0,0,0,8" TextChanged="OnFieldChanged" />

                                <TextBlock Foreground="#FF7A7A90" FontSize="11" TextWrapping="Wrap"
                                           Text="«Проверить» подставит последний тег и список ассетов. Ссылка вида https://github.com/owner/repo/releases распознаётся автоматически." />
                            </StackPanel>

                            <TextBlock x:Name="HintText" Foreground="#FF7A7A90" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Для категории поля действия игнорируются: в меню она открывает вложенный круг." />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Статус -->
        <DockPanel Grid.Row="2" Margin="10,0,10,10">
            <TextBlock x:Name="StatusText" Text="Изменения применяются после «Сохранить»"
                       Foreground="#FF9A9AB0" />
        </DockPanel>
    </Grid>
</Window>
